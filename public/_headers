/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://script.google.com https://script.googleusercontent.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://script.google.com https://script.googleusercontent.com; manifest-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/admin.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/assets/rsvp-config.js
  Cache-Control: no-cache, no-store, must-revalidate

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/story/*
  Cache-Control: public, max-age=31536000, immutable
